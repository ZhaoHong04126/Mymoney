<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Mymoney" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowBackground">@color/bg_screen</item>
        <item name="android:statusBarColor">@color/bg_screen</item>
        <item name="android:navigationBarColor">@color/bg_card</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
        <item name="colorPrimary">@color/amber_primary</item>
        <item name="colorPrimaryDark">@color/amber_dark</item>
        <item name="colorAccent">@color/amber_primary</item>
    </style>

    <style name="WarmBottomSheetDialog" parent="Theme.AppCompat.Light.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.45</item>
    </style>

    <style name="WarmCenterDialog" parent="Theme.AppCompat.Light.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.45</item>
    </style>

    <style name="WarmDatePickerDialogLight" parent="android:Theme.Material.Light.Dialog">
        <item name="android:colorAccent">@color/amber_primary</item>
        <item name="android:colorPrimary">@color/amber_primary</item>
    </style>

    <style name="WarmDatePickerDialogDark" parent="android:Theme.Material.Dialog">
        <item name="android:colorAccent">@color/amber_primary</item>
        <item name="android:colorPrimary">@color/amber_primary</item>
    </style>
</resources>
